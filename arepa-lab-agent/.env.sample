# Claude uses an /anthropic endpoint. GPT can use a Foundry project endpoint
# (.../api/projects/<project>) or a complete /openai/v1 endpoint.
FOUNDRY_ENDPOINT="https://<your-resource>.services.ai.azure.com/anthropic"
FOUNDRY_API_KEY="<your-api-key>"
FOUNDRY_MODEL_DEPLOYMENT="claude-sonnet-4-6"
MCP_SERVER_URL="http://127.0.0.1:8000/mcp/"
